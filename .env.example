# ==============================================================================
# WeSaver - 微信端 AI 影视资源转存与种草助手 配置文件模板
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DeepSeek 大模型配置 (核心大脑：用于自然语言找片、影视俗称纠错、小红书种草笔记推荐)
# ------------------------------------------------------------------------------
# 必填：请前往 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 选填：接口 Base URL，默认官方地址为 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 选填：模型名称，官方最新主力多模态模型推荐使用 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash

# ------------------------------------------------------------------------------
# 1.5 跨语种片名官方译名对齐配置 (可选)
# ------------------------------------------------------------------------------
# 选填：TMDB API Key（支持 v3 API Key 或 v4 Read Access Token）
# 配置后启用方案 B：外语海报识图与跨语种搜索优先通过 TMDB 对齐官方中文译名与港台/外语别名；
# 若留空则自动使用方案 A（豆瓣/Bangumi 公开片库 + 大模型反直译实体消歧与别名扩展）。
TMDB_API_KEY=

# ------------------------------------------------------------------------------
# 2. 夸克网盘配置 (用于一键转存、自动分类整理与防和谐改名)
# ------------------------------------------------------------------------------
# 选填：夸克网盘登录 Cookie（可在安装后直接在微信聊天框给机器人发送「/set-quark 你的Cookie」进行绑定）
# 获取方式：电脑浏览器打开 pan.quark.cn 登录，按 F12 打开开发者工具，在 Network（网络）标签中点击任意请求，复制 Request Headers 中的 Cookie
QUARK_COOKIE=

# 选填：默认转存网盘类型，目前优先推荐 quark
DEFAULT_PAN=quark

# 选填：转存默认保存目录，支持多层级嵌套，如 /我的资源 或 /我的影视/追剧（系统会自动层级创建）
DEFAULT_SAVE_DIR=/我的资源

# ------------------------------------------------------------------------------
# 3. Telegram 资源频道配置 (用于全网联合搜片活链，无需魔法/无需翻墙，国内直连抓取)
# ------------------------------------------------------------------------------
# 选填：若留空，系统将自动采用内置的 50 个优质影视资源频道（包含夸克/阿里/115等）
# 示例：TG_CHANNELS=shareAliyun,Quark_Movies,hao115,guaguale115
TG_CHANNELS=

# ------------------------------------------------------------------------------
# 4. 服务网络与调试配置
# ------------------------------------------------------------------------------
PORT=3001
DEBUG=false
# 选填：HTTP 网关 (/api/chat) 鉴权令牌，配置后需在请求头携带 Authorization: Bearer <token>
API_AUTH_TOKEN=
